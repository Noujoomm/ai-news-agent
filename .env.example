# ===========================================================================
# انسخ هذا الملف إلى .env وعبّي قيمك:   cp .env.example .env
# ملف .env محمي بـ .gitignore — ما يرتفع على GitHub أبدًا
# ===========================================================================

# ===== إلزامي =====
TELEGRAM_BOT_TOKEN=ضع_توكن_البوت_هنا
TELEGRAM_CHAT_ID=ضع_رقم_الشات_هنا

# ===== هوية البراند =====
BRAND_NAME="مازن — متخصص AI"
BRAND_CTA="عندك فكرة تطبيق أو مشروع AI؟ تابعني وراسلني وأنا أحولها لواقع 🚀"

# ===========================================================================
# 🔴 المراقبة اللحظية (watch.py) — أي خبر AI جديد يوصلك فورًا
# ===========================================================================

# كل كم ثانية يفحص كل المصادر
WATCH_INTERVAL_SECONDS=300

# يتجاهل أي خبر أقدم من كذا ساعة
WATCH_MAX_AGE_HOURS=24

# أقصى عدد رسائل في الجولة الوحدة (الباقي يجي كملخّص برسالة وحدة)
WATCH_MAX_PER_CYCLE=20

# ثواني بين كل رسالة والثانية (حدود تليجرام)
WATCH_SEND_DELAY=1.5

# أول تشغيل: يسجّل الأخبار الموجودة كـ"مقروءة" بدل ما يرسل مئات الأخبار دفعة وحدة
WATCH_SEED_ON_FIRST_RUN=true

# يرفق هوك جاهز للريل مع كل خبر
WATCH_INCLUDE_HOOK=true

# يمنع نفس الخبر لو وصل من مصدرين مختلفين
WATCH_DEDUPE_TITLES=true

# يرسل أخبار الذكاء الاصطناعي فقط
WATCH_ONLY_AI=true

# يستبعد الضجيج (توقعات مباريات، مقالات أسهم تسويقية، أبراج...)
WATCH_FILTER_NOISE=true

# كلمات إضافية تبغى تحجبها — مفصولة بفواصل
WATCH_BLOCK_KEYWORDS=

# ناشرين تبغى تحجبهم — مفصولة بفواصل، مثال: The Motley Fool,365Scores
WATCH_BLOCK_SOURCES=

# المناطق المتابَعة — فاضي = الافتراضي (كل شي ما عدا الأبحاث)
# المتاح: saudi,gulf,arabic,usa,china,asia,europe,community,research,global
# اكتب all عشان تشمل الأبحاث (arXiv — حجمها كبير جدًا)
WATCH_REGIONS=

# ملف ذاكرة الأخبار المرسلة وكم يوم يحتفظ فيها
WATCH_STATE_FILE=.seen_news.json
WATCH_STATE_TTL_DAYS=7

# عدد المصادر اللي تُجلب بالتوازي
WATCH_WORKERS=12

# ===========================================================================
# 📰 النشرة اليومية (main.py / scheduler.py)
# ===========================================================================
DAILY_SEND_TIME=08:00
MAX_NEWS_ITEMS=8
MAX_GITHUB_REPOS=5

# ===== وضع الذكاء (اختياري — Ollama محلي) =====
USE_LLM=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
